# === Mode ===
# true  = single-tenant self-host, no billing, operator's own API keys
# false = multi-tenant hosted SaaS, Stripe billing + per-org credit metering
SELF_HOSTED=true

# === Database ===
# Restricted role (NOSUPERUSER NOBYPASSRLS) - what the app actually runs
# as. RLS silently does nothing if this is a superuser role. See
# packages/db/README.md.
DATABASE_URL=postgres://rosterseo_app:rosterseo_dev@localhost:5432/rosterseo
# Elevated role, used only by `pnpm db:migrate` / drizzle-kit (DDL needs
# table-owner or superuser privileges). Falls back to DATABASE_URL if unset.
DATABASE_MIGRATE_URL=postgres://postgres:postgres@localhost:5432/rosterseo

# === PageSpeed Insights (Core Web Vitals for Site Audit / Page Analyzer) ===
# Optional - the API works unauthenticated at a much lower rate limit, so
# this is only needed to avoid throttling on multi-page audits. One global
# key for the whole workspace (not per-project), same as BING_WEBMASTER_API_KEY
# below - no in-app UI to set this, env var only. Get one from
# https://console.cloud.google.com (enable the PageSpeed Insights API).
GOOGLE_PAGESPEED_API_KEY=

# === Auth (better-auth) ===
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Client-side base URL for the auth client - distinct from BETTER_AUTH_URL
# above (server-side). Usually the same value; set separately only if
# your app is reachable at a different URL from the browser than from the
# server itself.
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# The app's own real public URL - used where a background process (the
# MCP server, IndexNow submission) needs to build a URL back into this app
# with no inbound HTTP request of its own to read an origin from. Required
# for apps/mcp-server's submit_urls_to_indexnow tool; falls back sensibly
# elsewhere.
APP_URL=http://localhost:3000

# === SEO data provider ===
# Raw login/password from your DataForSEO dashboard - the app composes the
# Basic Auth header itself. Do NOT paste a pre-encoded "login:password"
# base64 string here as the password.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# === AI-visibility providers ===
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
PERPLEXITY_API_KEY=
# Real scraped ChatGPT/Gemini/Perplexity/Copilot + Google AI Overview.
BRIGHTDATA_API_TOKEN=
# Required for the Google AI Overview sample specifically (the others use
# BrightData's dataset-collector API instead, no zone needed) - must match
# a real zone name from your BrightData dashboard -> Proxies & Scraping.
# Defaults to "sdk_serp" if unset, which only works if BrightData
# auto-provisioned a zone with that exact name for your account - it
# usually doesn't, so most accounts need to set this explicitly or you'll
# get a "zone ... not found" error.
BRIGHTDATA_SERP_ZONE=
# Pass-through gateway to any OpenRouter-hosted model, one key.
OPENROUTER_API_KEY=
# Optional model-slug overrides for OpenRouter-backed structured research -
# each has a real default and only needs setting to try a different model.
OPPORTUNITIES_OPENROUTER_MODEL=
PAGE_ANALYZER_OPENROUTER_MODEL=

# === Google OAuth (GSC + GA4 + Merchant Center) ===
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional explicit override for the OAuth callback URL - only needed if
# it can't be derived correctly from BETTER_AUTH_URL/APP_URL for your
# deployment (e.g. running behind a proxy that changes the host).
GOOGLE_OAUTH_REDIRECT_URI=

# === Publish blog OAuth (WordPress.com, Tumblr) ===
# Optional - both platforms still work via a manually-pasted token if
# these are unset, but connecting is one click instead of a manual token
# for your users once configured. Register an app at
# developer.wordpress.com/apps / tumblr.com/oauth/apps with the redirect
# URL <your deployment URL>/api/integrations/blog/callback.
WORDPRESS_COM_CLIENT_ID=
WORDPRESS_COM_CLIENT_SECRET=
TUMBLR_CLIENT_ID=
TUMBLR_CLIENT_SECRET=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

# Webflow
WEBFLOW_CLIENT_ID=
WEBFLOW_CLIENT_SECRET=

# Shopify
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# === Social OAuth (LinkedIn, Pinterest, Facebook/Instagram, Threads, X) ===
# All optional - Bluesky (app password) and Mastodon (dynamic per-instance
# registration) need none of these. Every other platform still works via a
# manually-pasted token if its pair is unset, but connecting is one click
# once configured. Redirect URL for all of these:
# <your deployment URL>/api/integrations/social/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
# One Meta app covers both Facebook Pages and Instagram (different scopes,
# same app) - register at developers.facebook.com.
META_CLIENT_ID=
META_CLIENT_SECRET=
# Threads needs its own App ID/Secret even though it's configured inside
# the same Meta App dashboard as the app above.
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
# X charges per post once connected (no free tier) - only set this up if
# you've funded a prepaid balance on your X developer account.
X_CLIENT_ID=
X_CLIENT_SECRET=

# === Bing Webmaster Tools ===
# One global API key for the whole workspace (not per-project OAuth) - get
# it from Bing Webmaster Tools -> Settings -> API access.
BING_WEBMASTER_API_KEY=

# === MCP server (apps/mcp-server) ===
# Required for the standalone MCP server to start at all - generate a real
# key from the app's AI & MCP settings page (shown once at creation) and
# put it here, or set it directly in your MCP client config instead.
ROSTERSEO_API_KEY=

# === Billing (hosted SaaS mode only, SELF_HOSTED=false) ===
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# === Observability (all optional - fully inert if unset) ===
# Error tracking. Get a free DSN at sentry.io (or self-host Sentry).
# NEXT_PUBLIC_SENTRY_DSN is the same value, just exposed to the browser -
# server-only SENTRY_DSN isn't readable client-side.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Only needed if you want source maps uploaded on build (better stack
# traces) - leave unset to skip that step entirely.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Product analytics. Get a free key at posthog.com (or self-host PostHog).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
