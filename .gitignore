# Dependencies
node_modules/
.pnpm-store/

# Build outputs / caches
.turbo/
.next/
dist/
build/
*.tsbuildinfo

# Env files - never commit real secrets. .env.example is the only
# env-shaped file meant to be tracked (see .gitignore's negation below).
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS / editor junk
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# Test/coverage output
coverage/
.vitest-cache/

# Claude Code - settings.local.json is per-developer (tool permission
# allowlists etc.), never shared; launch.json (dev-server config) IS
# shared/committed since other contributors need it too.
.claude/settings.local.json

# Local reference clones used during development, and any unrelated
# scratch project folders that end up at the repo root - these are
# separate codebases with their own licenses, not part of this project,
# and must never be published inside this repo.
elmo-reference/
open-seo-reference/
postiz-reference/
seo tool hubspot/
seo-saas-ord-v1.md
