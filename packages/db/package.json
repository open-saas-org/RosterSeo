{
  "name": "@rosterseo/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "tsx --env-file=../../apps/web/.env src/migrate.ts",
    "build": "esbuild src/migrate.ts --bundle --external:pg --platform=node --target=node20 --format=esm --outfile=dist/migrate.mjs && npm install --omit=dev --no-save --no-package-lock --prefix dist pg@^8.13.0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.38.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.0",
    "drizzle-kit": "^0.30.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
